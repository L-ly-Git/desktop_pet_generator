{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action.schema.json",
  "title": "Window Pet Action",
  "description": "契约 v1 的共享动作格式",
  "type": "object",
  "required": ["id", "duration", "loop", "tracks"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "display_name": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "loop": {
      "type": "boolean"
    },
    "easing": {
      "enum": ["linear", "ease_in", "ease_out", "ease_in_out", "step"]
    },
    "tracks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/track"}
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "tx": {"$ref": "#/$defs/keyframes"},
        "ty": {"$ref": "#/$defs/keyframes"},
        "rot": {"$ref": "#/$defs/keyframes"},
        "sx": {"$ref": "#/$defs/keyframes"},
        "sy": {"$ref": "#/$defs/keyframes"}
      }
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "v"],
        "additionalProperties": false,
        "properties": {
          "t": {"type": "number", "minimum": 0},
          "v": {"type": "number"},
          "ease": {"enum": ["linear", "ease_in", "ease_out", "ease_in_out", "step"]}
        }
      }
    }
  }
}